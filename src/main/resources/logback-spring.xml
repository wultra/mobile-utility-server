<?xml version="1.0" encoding="UTF-8"?>
<!-- Default logging configuration used when no logging.config override is provided.
     For JSON (Logstash) output, set MOBILE_UTILITY_SERVER_LOGGING to the JSON config path. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <conversionRule conversionWord="sa" class="com.wultra.core.logging.logback.StructuredArgumentsConverter"/>
    <springProperty scope="context" name="consoleLogPattern" source="logging.pattern.console"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%sa%n%ex"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${consoleLogPattern}</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
