<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="Pavel Sindelar" logicalFilePath="mobile-utility-server/2.0.x/20260116-ssl-pinning-depth.xml">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="mus_certificate" columnName="depth"/>
            </not>
        </preConditions>
        <comment>Add depth column to mus_certificate table</comment>
        <addColumn tableName="mus_certificate">
            <column name="depth" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="2" author="Pavel Sindelar" logicalFilePath="mobile-utility-server/2.0.x/20260116-ssl-pinning-depth.xml">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="mus_mobile_domain" columnName="ssl_pinning_required"/>
            </not>
        </preConditions>
        <comment>Add ssl_pinning_required column to mus_mobile_domain table</comment>
        <addColumn tableName="mus_mobile_domain">
            <column name="ssl_pinning_required" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
